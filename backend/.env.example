# 複製成 backend/.env 後填入金鑰。.env 已列在 .gitignore,不會被提交。

# Google AI Studio 的金鑰(https://aistudio.google.com/apikey),免費額度即可
GEMINI_API_KEY=

# 模型名稱;預設 gemini-flash-latest(永遠指向最新的 Flash)。額度用完可改 gemini-flash-lite-latest
# FACTORYMIND_LLM_MODEL=gemini-flash-latest

# 改用 Gemma(免費額度的每日次數多很多):
# FACTORYMIND_LLM_MODEL=gemma-4-26b-a4b-it

# 落地改用廠內 vLLM 時,指向它的 OpenAI 相容端點,金鑰可留空
# FACTORYMIND_LLM_BASE_URL=http://gpu-host:8000/v1
# FACTORYMIND_LLM_MODEL=Qwen/Qwen3-8B
